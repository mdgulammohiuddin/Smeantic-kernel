Handles the “Type your question here” input field and send button, with API integration.

```jsx
import { useState } from 'react';
import { sendMessage } from '../../config/api';

function InputBar({ onSend }) {
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);

  const handleSend = async () => {
    if (input.trim()) {
      onSend(input, true); // User message
      setIsLoading(true);
      try {
        const response = await sendMessage(input);
        onSend(response.data.message, false); // Bot response
      } catch (error) {
        onSend('Error: Could not connect to server', false);
      } finally {
        setInput('');
        setIsLoading(false);
      }
    }
  };

  return (
    <div className="p-4 border-t bg-white flex">
      <input
        type="text"
        value={input}
        onChange={(e) => setInput(e.target.value)}
        onKeyPress={(e) => e.key === 'Enter' && handleSend()}
        className="flex-1 p-2 border rounded-l-lg focus:outline-none"
        placeholder="Type your question here..."
        aria-label="Chat input"
        disabled={isLoading}
      />
      <button
        onClick={handleSend}
        className="bg-blue-500 text-white p-2 rounded-r-lg hover:bg-blue-600 disabled:bg-blue-300"
        aria-label="Send message"
        disabled={isLoading}
      >
        Send
      </button>
    </div>
  );
}

export default InputBar;
```

